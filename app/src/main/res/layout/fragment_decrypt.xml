<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/anon_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <TextView
            style="@style/SectionHeader"
            android:text="// MODE" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/modeText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TEXT"
                android:textColor="@color/anon_white"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:checked="true"
                android:buttonTint="@color/anon_white" />

            <RadioButton
                android:id="@+id/modeFile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="FILE"
                android:textColor="@color/anon_white"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:buttonTint="@color/anon_white" />
        </RadioGroup>

        <!-- TEXT MODE -->
        <LinearLayout
            android:id="@+id/textPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/ciphertextIn"
                style="@style/AnonField"
                android:hint="@string/hint_paste_ciphertext"
                android:minLines="5"
                android:maxLines="12" />

            <Button
                android:id="@+id/btnDecryptText"
                style="@style/AnonBtn"
                android:layout_width="match_parent"
                android:text="DECRYPT TEXT &#8594;" />

            <EditText
                android:id="@+id/plaintextOut"
                style="@style/AnonField"
                android:hint="@string/hint_plaintext_result"
                android:minLines="4"
                android:maxLines="10"
                android:focusable="true"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- FILE MODE -->
        <LinearLayout
            android:id="@+id/filePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/pickedFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/anon_dim"
                android:padding="12dp"
                android:textColor="@color/anon_mid"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="(no encrypted file picked)"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnPickFile"
                style="@style/AnonBtn"
                android:layout_width="match_parent"
                android:text="PICK ENCRYPTED FILE" />

            <Button
                android:id="@+id/btnDecryptFile"
                style="@style/AnonBtn"
                android:layout_width="match_parent"
                android:text="DECRYPT &amp; SAVE AS… &#8594;"
                android:enabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
